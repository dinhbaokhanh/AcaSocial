# ===== SERVER =====
PORT=8080

# ===== JWT =====
JWT_SECRET=your_jwt_secret_min_32_chars

# ===== REDIS =====
REDIS_URL=localhost:6379
REDIS_PASSWORD=your_redis_password

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Backend Service URLs =====
IDENTITY_SERVICE_URL=http://localhost:8081
MEDIA_SERVICE_URL=http://localhost:8082
DISCUSSION_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8085

# ===== Internal Service Auth =====
# Shared secret giữa Gateway và các service nội bộ.
# Phải khớp với INTERNAL_SERVICE_TOKEN trong từng service.
INTERNAL_SERVICE_TOKEN=your_internal_service_token
