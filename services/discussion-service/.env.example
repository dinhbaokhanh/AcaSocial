# ===== SERVER =====
PORT=8084
NATS_URL=nats://localhost:4222
IDENTITY_SERVICE_URL=http://localhost:8081
MEDIA_SERVICE_URL=http://localhost:8082
ACADEMIC_SERVICE_URL=http://localhost:8086
AI_SERVICE_URL=http://localhost:8087
INTERNAL_SERVICE_TOKEN=your_internal_service_token
# Secret for anonymous nicknames (falls back to INTERNAL_SERVICE_TOKEN)
ANONYMOUS_ALIAS_SECRET=your_anonymous_alias_secret
DB_SYNCHRONIZE=true

# ===== DATABASE (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=discussion_db

# Room closure worker and schedule API. Set false to pause execution; deadlines still block writes.
ROOM_LIFECYCLE_ENABLED=true
ROOM_CLOSURE_MIN_NOTICE_HOURS=168
